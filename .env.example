# Copy this file to .env and set your MongoDB connection string once the database is created.
# Example local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/electrostock
# Example MongoDB Atlas:
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/electrostock?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/electrostock?serverSelectionTimeoutMS=3000